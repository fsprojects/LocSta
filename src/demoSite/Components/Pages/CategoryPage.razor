@page "/category/{Slug}"
@inject DemoSite.Data.BlockDataService DataService
@using DemoSite.Data
@using System.Linq

@if (found) {
    <h1>@category.Name</h1>
    @foreach (var block in category.Blocks) {
        <BlockCard Block="block" />
    }
} else {
    <h1>Category not found</h1>
}

@code {
    [Parameter] public string? Slug { get; set; }
    private Category category;
    private bool found;

    protected override void OnParametersSet() {
        var match = DataService.Categories
            .FirstOrDefault(c => c.Slug == Slug);
        found = match.Slug != null;
        category = match;
    }
}
