<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generators -->
    <Compile Include="Generators/CounterTests.fs" />
    <Compile Include="Generators/FibonacciTests.fs" />
    <!-- Delay -->
    <Compile Include="Delay/DelayBy1Tests.fs" />
    <Compile Include="Delay/DelayByNTests.fs" />
    <!-- State -->
    <Compile Include="State/HoldTests.fs" />
    <Compile Include="State/LatchTests.fs" />
    <Compile Include="State/EdgeTests.fs" />
    <Compile Include="State/ChangedTests.fs" />
    <!-- Arithmetic -->
    <Compile Include="Arithmetic/DiffTests.fs" />
    <Compile Include="Arithmetic/CumulativeSumTests.fs" />
    <Compile Include="Arithmetic/CumulativeProductTests.fs" />
    <Compile Include="Arithmetic/ClampTests.fs" />
    <Compile Include="Arithmetic/RescaleTests.fs" />
    <!-- Statistics -->
    <Compile Include="Statistics/EmaTests.fs" />
    <Compile Include="Statistics/RollingStdDevTests.fs" />
    <Compile Include="Statistics/RollingMinTests.fs" />
    <Compile Include="Statistics/RollingMaxTests.fs" />
    <Compile Include="Statistics/RunningMinTests.fs" />
    <Compile Include="Statistics/RunningMaxTests.fs" />
    <!-- Detection -->
    <Compile Include="Detection/CrossoverTests.fs" />
    <Compile Include="Detection/ThresholdTests.fs" />
    <!-- Logic -->
    <Compile Include="Logic/DebounceTests.fs" />
    <Compile Include="Logic/ToggleTests.fs" />
    <!-- Counting -->
    <Compile Include="Counting/CountWhereTests.fs" />
    <Compile Include="Counting/CountSinceTests.fs" />
    <Compile Include="Counting/CountInTests.fs" />
    <Compile Include="Counting/TimeSinceTests.fs" />
    <Compile Include="Counting/RateTests.fs" />
    <!-- Windowing -->
    <Compile Include="Windowing/WindowedReduceTests.fs" />
    <Compile Include="Windowing/SegmentTests.fs" />
    <!-- DSP: Oscillators -->
    <Compile Include="Dsp/Oscillators/SineOscTests.fs" />
    <Compile Include="Dsp/Oscillators/SawOscTests.fs" />
    <Compile Include="Dsp/Oscillators/SquareOscTests.fs" />
    <Compile Include="Dsp/Oscillators/TriangleOscTests.fs" />
    <Compile Include="Dsp/Oscillators/WhiteNoiseTests.fs" />
    <!-- DSP: Filters -->
    <Compile Include="Dsp/Filters/LowPass1Tests.fs" />
    <Compile Include="Dsp/Filters/HighPass1Tests.fs" />
    <Compile Include="Dsp/Filters/BiquadLowPassTests.fs" />
    <Compile Include="Dsp/Filters/BiquadHighPassTests.fs" />
    <Compile Include="Dsp/Filters/BiquadBandPassTests.fs" />
    <Compile Include="Dsp/Filters/DcBlockTests.fs" />
    <!-- DSP: Envelope -->
    <Compile Include="Dsp/Envelope/EnvFollowTests.fs" />
    <Compile Include="Dsp/Envelope/AdsrTests.fs" />
    <!-- DSP: Dynamics -->
    <Compile Include="Dsp/Dynamics/SoftClipTests.fs" />
    <Compile Include="Dsp/Dynamics/HardClipTests.fs" />
    <Compile Include="Dsp/Dynamics/GateTests.fs" />
    <!-- DSP: Modulation -->
    <Compile Include="Dsp/Modulation/RingModTests.fs" />
    <Compile Include="Dsp/Modulation/BitCrushTests.fs" />
    <Compile Include="Dsp/Modulation/CrossfadeTests.fs" />
    <!-- DSP: Analysis -->
    <Compile Include="Dsp/Analysis/RmsTests.fs" />
    <Compile Include="Dsp/Analysis/ZeroCrossRateTests.fs" />
    <Compile Include="Dsp/Analysis/PeakHoldTests.fs" />
